#!/bin/bash
# 双击这个文件就能玩最新版本。
#
# 当前是 24px 调试人物阶段（2026-08-26 起）：直接打开占位版，不跑 bake.py。
# 家庭美术 bake 暂时停用，阶段 4 恢复后本脚本会改回"生成并打开美术版"。
#
# 操作方式（本地双人 1v1，人对人）：
#   1P（阳阳）：A/D 换方向·选跳跃方向   W/S 上浮/按住下潜
#               F 水面跳跃/水下加速     G 水面换气/水下踢击/肩组出拳
#   2P（爸爸）：← → 换方向·选跳跃方向   ↑ ↓ 上浮/按住下潜
#               K 水面跳跃/水下加速     L 水面换气/水下踢击/肩组出拳
#   Enter 或 R：重新开始

cd "$(dirname "$0")" || exit 1

GAME="阳阳水泳大乱斗-原版复刻.html"
if [ ! -f "$GAME" ]; then
  echo ""
  echo "  没找到 $GAME。把这句话告诉 AI。"
  echo ""
  echo "按回车键关闭。"; read -r _; exit 1
fi

echo ""
echo "  正在打开游戏（24px 调试人物版·本地双人 1v1）……玩得开心。"
echo ""
echo "  1P(阳阳)  A/D 方向  W/S 上浮/下潜  F 跳跃/加速  G 换气/踢击/出拳"
echo "  2P(爸爸)  ← → 方向  ↑ ↓ 上浮/下潜  K 跳跃/加速  L 换气/踢击/出拳"
echo "  Enter 或 R  重新开始"
echo ""
open "$GAME"

echo "按回车键关闭这个窗口（游戏会继续开着）。"
read -r _
